NODE_ENV=development
PORT=3001

DATABASE_URL=postgres://afribit:afribit@localhost:5432/afribit
REDIS_URL=redis://localhost:6379

# https://openrouter.ai/keys — server-side only, never expose to the browser.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_ZDR_ONLY=true

# Disabled by default per PRD §35 — enable only for a documented review process.
PROMPT_LOGGING_ENABLED=false

CORS_ORIGIN=http://localhost:5173

# Auth (contributor/admin accounts for Microtasks + knowledge management --
# the anonymous chat flow never needs this). REQUIRED in production
# (assertProductionEnv() in config/env.ts refuses to boot without it) --
# the fallback below is dev-only and MUST NOT be used in production, since
# anyone who knows it could forge admin JWTs.
# Generate a real one with: openssl rand -hex 32
JWT_SECRET=afribit-dev-only-insecure-secret-do-not-use-in-production

# Web Push / PWA notifications.
# Generate with:
#   pnpm --filter @afribit/api exec web-push generate-vapid-keys
# Keep the private key server-side only.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@afribit.ai

# Where chat inference runs: cloud (default, OpenRouter), node (a community node's own
# model server -- nothing leaves the network), or hybrid (node first, cloud if it fails).
# See deploy/community-node/README.md and docs/adr/0009-inference-modes-and-privacy.md.
INFERENCE_MODE=cloud
# Where members are told the model runs (docs/features/F-001): auto | community | afribit. "auto" says
# "this community's server" only when LOCAL_LLM_BASE_URL is this machine or a sibling container.
MODEL_LOCATION=auto
# How long chat text is kept (docs/features/F-002): none | <N>d | keep. Default 30d (agreed 8 Oct 2026).
CHAT_RETENTION=30d
# Who may create an account (docs/features/F-012): invite (default; single-use codes from an administrator),
# closed, or open (development only; the server warns elsewhere).
REGISTRATION=invite
# Used by node and hybrid modes. Ollama by default; set LOCAL_LLM_API=openai for vLLM,
# llama.cpp's llama-server or Open WebUI.
# LOCAL_LLM_BASE_URL=http://localhost:11434
# LOCAL_LLM_API=ollama
# LOCAL_LLM_MODEL=gemma3:12b
# LOCAL_LLM_NUM_CTX=8192

# Embeddings find the right knowledge card for each question. Vectors are stored per model, so
# switching is a setting plus: pnpm --filter @afribit/api knowledge:embed   (docs/adr/0013-local-embeddings.md)
#   openrouter (default for cloud/hybrid): EMBEDDING_MODEL, e.g. baai/bge-m3 (best in our benchmark) or openai/text-embedding-3-small
#   local      (default for node mode):   LOCAL_EMBEDDING_MODEL, default bge-m3, runs on the node's CPU
# EMBEDDING_PROVIDER=openrouter
# EMBEDDING_MODEL=baai/bge-m3
# LOCAL_EMBEDDING_MODEL=bge-m3

# Websites allowed to call the API from a browser: one origin, or several separated by commas.
# CORS_ORIGIN=https://ai.example.org,https://www.ai.example.org

# --- Knowledge review ---------------------------------------------------------
# true = whoever last edited a card cannot be the one to approve/publish it. Turn on once you have two or more reviewers.
REVIEW_TWO_PERSON=false
