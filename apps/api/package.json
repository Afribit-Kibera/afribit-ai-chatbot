{
  "name": "@afribit/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed:manuals": "tsx src/db/seedCommunityManuals.ts",
    "db:promote:manuals": "tsx src/db/promoteCommunityManuals.ts",
    "db:promote:admin": "tsx src/db/promoteToAdmin.ts",
    "dataset:campaign": "tsx src/dataset-lab/runCampaign.ts",
    "dataset:eval": "tsx src/dataset-lab/runEval.ts",
    "test:prompt-golden": "tsx src/dataset-lab/promptGoldenCases.ts",
    "dataset:communication-eval": "tsx src/dataset-lab/runCommunicationEval.ts",
    "dataset:fallback-bakeoff": "tsx src/dataset-lab/runFallbackBakeoff.ts",
    "knowledge:embed": "tsx src/knowledge/embedBackfill.ts"
  },
  "dependencies": {
    "@afribit/shared": "workspace:*",
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^10.2.2",
    "@fastify/rate-limit": "^11.2.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0",
    "fastify-plugin": "^6.0.0",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.10",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
