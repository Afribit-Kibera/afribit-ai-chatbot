# Copy to .env and fill in. Never commit .env.

# --- Required -------------------------------------------------------------
POSTGRES_PASSWORD=
# Generate with: openssl rand -hex 32
JWT_SECRET=

# --- Where people reach the node -------------------------------------------
# A name that resolves to this machine on your network (see README).
NODE_HOSTNAME=afribit.local
# internal = local CA (works offline; phones must trust it once)
# an email address = real Let's Encrypt certificate
CADDY_TLS=internal

# --- The model --------------------------------------------------------------
# node   = local model only; nothing leaves your network (default)
# hybrid = node first, cloud if the node fails (needs OPENROUTER_API_KEY; sends questions off-network)
INFERENCE_MODE=node
# Where members are told the model runs (auto | community | afribit). Leave auto when the model runs in the
# ollama container on this machine. An Afribit Local box whose model is Afribit's GPU server MUST say afribit.
MODEL_LOCATION=auto
# How long chat text is kept here: none (only in people's own browsers), a number of days such as 30d, or keep.
# The pilot node keeps none (agreed 8 Oct 2026). Members are told this setting in the app.
CHAT_RETENTION=none
# Accounts are for the people who teach and check the assistant; members chat without one. invite (default): an
# administrator creates single-use codes (console Team tab, or: docker compose exec api node dist/auth/inviteCli.js
# --role reviewer). closed: no new accounts. open: anyone; development only.
REGISTRATION=invite
# Any Ollama model tag. Default: Gemma 3 12B, the best performer in our Sheng/Kiswahili evaluation. Pick the smallest model that passes your own language checks (see README).
# Which community pack this node serves (a folder under packs/). kibera-bitcoin is the built-in one.
COMMUNITY_PACK=kibera-bitcoin
# To serve SEVERAL communities from this node, list their pack ids (folders under packs/) instead.
# Each needs its own retrieval domain and card ids; the node refuses to start otherwise. Leave empty for one pack.
# COMMUNITY_PACKS=kibera-bitcoin,example-library
# Which one answers when a request names no pack (default: kibera-bitcoin if served, else the first by id).
# DEFAULT_PACK=kibera-bitcoin

# The Voice Lab: reviewers edit how the assistant talks at https://<NODE_HOSTNAME>/voice and try answers
# straight away. Set to any value (true) to switch it on. Edits are kept in the `overrides` volume (back it up).
# Leave empty to keep the pack exactly as it is in git.
VOICE_LAB=

LOCAL_LLM_MODEL=gemma3:12b
LOCAL_LLM_NUM_CTX=8192
# The model that finds the right knowledge card for each question; runs on the CPU. bge-m3 found the
# right card in the top 3 for 40 of 40 raw Sheng/Kiswahili questions in our benchmark.
LOCAL_EMBEDDING_MODEL=bge-m3
# Leave empty to let Ollama split the model across GPU and CPU. On a small GPU that can crash
# with "CUDA out of memory": set how many layers go on the GPU (0 = CPU only).
LOCAL_LLM_NUM_GPU=
OLLAMA_KEEP_ALIVE=24h

# --- Optional ---------------------------------------------------------------
OPENROUTER_API_KEY=
# Generate with: pnpm --filter @afribit/api exec web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.org
