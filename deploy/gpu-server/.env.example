# Copy to .env next to docker-compose.yml. Never commit .env.

# Pin the versions you tested (check-host.sh records them).
OLLAMA_VERSION=latest
NODE_VERSION=22

# The model(s) boxes may use. Empty = any model already on this server (boxes can never pull new ones).
GATE_ALLOWED_MODELS=gemma4:26b-a4b-it-q4_K_M

# How many answers Ollama works on at once (E-001: 4 on a 24 GB card).
OLLAMA_NUM_PARALLEL=4
OLLAMA_KEEP_ALIVE=24h

# The public name or IP of this server and the WireGuard port, as boxes will dial it (used by add-community.sh).
GPU_ENDPOINT=gpu.afribit.africa:51820
