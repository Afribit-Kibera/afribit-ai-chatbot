{
  "buildCommand": "pnpm --filter @afribit/web build",
  "outputDirectory": "apps/web/dist",
  "installCommand": "pnpm install --frozen-lockfile",
  "framework": "vite",
  "rewrites": [
    { "source": "/app", "destination": "/app/index.html" },
    { "source": "/app/settings", "destination": "/app/settings/index.html" },
    { "source": "/app/contribute", "destination": "/app/contribute/index.html" },
    { "source": "/privacy", "destination": "/privacy/index.html" },
    { "source": "/community", "destination": "/community/index.html" },
    { "source": "/sw", "destination": "/sw/index.html" },
    { "source": "/sh", "destination": "/sh/index.html" },
    { "source": "/sw/privacy", "destination": "/sw/privacy/index.html" },
    { "source": "/sh/privacy", "destination": "/sh/privacy/index.html" },
    { "source": "/sw/community", "destination": "/sw/community/index.html" },
    { "source": "/sh/community", "destination": "/sh/community/index.html" }
  ],
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public,max-age=31536000,immutable" }] }
  ]
}
